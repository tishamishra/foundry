{#
  The shell.

  Two things travel from data onto the document and drive everything below:

    data-hero / data-cards / data-headline / data-accent / data-rhythm
        the STYLE PACK. One hand-authored stylesheet carries a rule for each
        value, so a new look is a block of CSS and a line of YAML — never a
        new template and never a build step.

    :root custom properties
        the THEME. Colour and type are variables, so six palettes and six
        packs are 36 distinct looks over one stylesheet.

  Below the head it is a loop over a named section list. A section is a partial
  and its name in a list — no registry, no interface, no Python coupling. The
  list may repeat an entry, so ordering decisions live in data.
#}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# One place computes the absolute URL of this page and its share image; every
   SEO tag below reuses them so canonical, Open Graph and JSON-LD never drift. #}
{%- set page_url = 'https://' ~ site.domain ~ ('' if url == '/' else url) -%}
{%- set og_image = imgs.get('hero') -%}
{%- if og_image and not og_image.startswith('http') %}{% set og_image = 'https://' ~ site.domain ~ og_image %}{% endif -%}
{%- set is_local = kind in ('location', 'location_service', 'county') -%}
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href="{{ page_url }}">
{# --- Open Graph (Facebook, LinkedIn, WhatsApp, iMessage previews) --- #}
<meta property="og:site_name" content="{{ biz.company }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ 'business.business' if kind == 'home' else 'website' }}">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:locale" content="en_US">
{% if og_image %}<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:alt" content="{{ niche.label }} by {{ biz.company }}">{% endif %}
{# --- Twitter / X card --- #}
<meta name="twitter:card" content="{{ 'summary_large_image' if og_image else 'summary' }}">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
{% if og_image %}<meta name="twitter:image" content="{{ og_image }}">{% endif %}
{# --- Local-SEO geo hints on place pages (help Google tie the page to a place) --- #}
{% if is_local and t.state_abbr %}<meta name="geo.region" content="US-{{ t.state_abbr }}">
<meta name="geo.placename" content="{{ t.city if t.get('city') else t.county }}, {{ t.state_abbr }}">{% endif %}
<meta name="theme-color" content="{{ theme.brand }}">
{% if style.fonts_url %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ style.fonts_url }}">
{% endif %}
<link rel="stylesheet" href="/assets/css/site.css">
<style>
:root{
--brand:{{ theme.brand }};--brand-dark:{{ theme.brand_dark }};--brand-light:{{ theme.brand_light }};
--accent:{{ theme.accent }};--accent-text:{{ theme.accent_text }};--ink:{{ theme.ink }};
--muted:{{ theme.muted }};--line:{{ theme.line }};--surface:{{ theme.surface }};
--font-display:{{ style.display_font }};--font-body:{{ style.body_font }};
--radius:{{ style.radius }};
--star:{{ theme.get('star') or '#f6b100' }};
}
</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ niche.schema_type }}",
  "@id": "https://{{ site.domain }}/#business",
  "name": "{{ biz.company }}",
  "telephone": "{{ t.phone }}",
  {% if t.email %}"email": "{{ t.email }}",{% endif %}
  "url": "https://{{ site.domain }}/",
  {% if og_image %}"image": "{{ og_image }}",{% endif %}
  {% if facts.get('hours') %}"openingHours": "{{ facts.hours }}",{% endif %}
  {% set social = biz.get('social') or {} %}{% if social %}"sameAs": [{% for v in social.values() %}{{ v|tojson }}{{ "," if not loop.last }}{% endfor %}],{% endif %}
  {% if t.street %}"address": {"@type": "PostalAddress", "streetAddress": "{{ t.street }}", "addressLocality": "{{ t.hq_city }}", "addressRegion": "{{ t.hq_state }}", "postalCode": "{{ t.hq_zip }}", "addressCountry": "US"},{% endif %}
  "areaServed": [{% for c in counties[:12] %}{"@type": "AdministrativeArea", "name": "{{ c.name }}, {{ c.state_abbr }}"}{{ "," if not loop.last }}{% endfor %}]
}
</script>
{# --- WebSite entity: names the site and ties pages back to one publisher. --- #}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":{{ biz.company|tojson }},"url":"https://{{ site.domain }}/","publisher":{"@id":"https://{{ site.domain }}/#business"}}
</script>
{# --- BreadcrumbList: gives Google the page's place in the site so the SERP
   shows a breadcrumb trail instead of a bare URL. Built from the page kind. --- #}
{%- set crumbs = [{'n':'Home','u':'/'}] -%}
{%- if kind == 'service' and service is defined -%}{% set _ = crumbs.append({'n':'Services','u':'/services'}) %}{% set _ = crumbs.append({'n': service.name, 'u': url}) %}
{%- elif kind == 'location_service' and service is defined -%}{% set _ = crumbs.append({'n':'Services','u':'/services'}) %}{% set _ = crumbs.append({'n': service.name, 'u':'/services/' ~ service.slug}) %}{% set _ = crumbs.append({'n': t.city ~ ', ' ~ t.state_abbr, 'u': url}) %}
{%- elif kind == 'location' -%}{% set _ = crumbs.append({'n':'Service Areas','u':'/areas'}) %}{% set _ = crumbs.append({'n': t.city ~ ', ' ~ t.state_abbr, 'u': url}) %}
{%- elif kind == 'county' -%}{% set _ = crumbs.append({'n':'Service Areas','u':'/areas'}) %}{% set _ = crumbs.append({'n': t.county ~ ', ' ~ t.state_abbr, 'u': url}) %}
{%- elif kind == 'about' -%}{% set _ = crumbs.append({'n':'About','u':'/about'}) %}
{%- elif kind == 'contact' -%}{% set _ = crumbs.append({'n':'Contact','u':'/contact'}) %}
{%- elif kind == 'services' -%}{% set _ = crumbs.append({'n':'Services','u':'/services'}) %}
{%- elif kind == 'areas' -%}{% set _ = crumbs.append({'n':'Service Areas','u':'/areas'}) %}
{%- endif -%}
{% if crumbs|length > 1 %}<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for c in crumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ c.n|tojson }},"item":"https://{{ site.domain }}{{ '' if c.u == '/' else c.u }}"}{{ "," if not loop.last }}{% endfor %}]}
</script>{% endif %}
{# --- AEO: the FAQs are already on the page; this makes them machine-readable.
   Answer engines (Google AI Overviews, Perplexity, ChatGPT) lift Q&A straight
   from FAQPage markup, so the same content earns citations it otherwise would
   not. tojson escapes each string; {tokens} inside are resolved afterwards. #}
{% set faqlist = (lc.faqs if lc is defined else (svc.faqs if svc is defined else content.faqs)) %}
{% if faqlist %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{% for item in faqlist %}{"@type":"Question","name":{{ item.q|tojson }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a|tojson }}}}{{ "," if not loop.last }}
{% endfor %}]}
</script>
{% endif %}
{# --- AEO: a Service page should say, in machine terms, WHAT service and WHERE.
   Emitted on service and service-in-city pages, tied back to the business. #}
{% if kind in ('service', 'location_service') and service is defined %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Service","serviceType":{{ service.name|tojson }},
"provider":{"@type":"{{ niche.schema_type }}","name":{{ biz.company|tojson }},"telephone":"{{ t.phone }}"},
"areaServed":{% if t.city %}{"@type":"City","name":"{{ t.city }}, {{ t.state_abbr }}"}{% else %}[{% for c in counties[:12] %}{"@type":"AdministrativeArea","name":"{{ c.name }}, {{ c.state_abbr }}"}{{ "," if not loop.last }}{% endfor %}]{% endif %},
"url":"https://{{ site.domain }}{{ url }}"}
</script>
{% endif %}
</head>
<body class="page-{{ kind }}"
      data-style="{{ style.key }}"
      data-hero="{{ style.hero }}"
      data-cards="{{ style.cards }}"
      data-headline="{{ style.headline }}"
      data-accent="{{ style.accent }}"
      data-rhythm="{{ style.rhythm }}"
      data-skeleton="{{ skeleton.key }}"
      data-shell="{{ skeleton.shell }}">
{# Header and footer live in the shell, NOT in the per-page section lists, so
   they render on EVERY page unconditionally — no skeleton can drop them. #}
{% include "partials/header.html.j2" %}
<main id="main">
{% for section in sections %}
{% include "partials/" + section + ".html.j2" %}
{% endfor %}
</main>
{% include "partials/footer.html.j2" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>
