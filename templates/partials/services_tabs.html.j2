<section class="sec sec-alt">
  <div class="wrap">
    <h2 class="section-head">{{ content.headings.services or 'Services' }}</h2>
    <div class="tabs" data-tabs>
      <div class="tab-strip" role="tablist">
        {% for s in services %}
        <button class="tab" role="tab" data-tab="{{ s.slug }}" {{ 'aria-selected=true' if loop.first }}>{{ s.name }}</button>
        {% endfor %}
      </div>
      {% for s in services %}
      <div class="tab-panel" data-panel="{{ s.slug }}" {{ '' if loop.first else 'hidden' }}>
        <div class="tp-main">
          <h3>{{ s.name }}{% if t.city %} in {{ t.city }}{% endif %}</h3>
          <p class="tp-sum">{{ s.summary }}</p>
          <a class="btn btn-accent" href="{% if t.city and not single_service %}/services/{{ s.slug }}/{{ t.slug }}{% else %}/services/{{ s.slug }}{% endif %}">More on {{ s.name|lower }} &rarr;</a>
        </div>
        <ul class="tp-points">
          {% for b in content.trust %}
          <li>
            <span class="tp-check" aria-hidden="true"><svg viewBox="0 0 24 24" width="13" height="13"><path d="M5 12.5l4.2 4.3L19 7" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span>{{ b.title }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
