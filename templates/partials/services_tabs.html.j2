<section class="sec sec-alt">
  <div class="wrap">
    <h2 class="section-head">Services</h2>
    <div class="tabs" data-tabs>
      <div class="tab-strip" role="tablist">
        {% for s in services %}
        <button class="tab" role="tab" data-tab="{{ s.slug }}" {{ 'aria-selected=true' if loop.first }}>{{ s.name }}</button>
        {% endfor %}
      </div>
      {% for s in services %}
      <div class="tab-panel" data-panel="{{ s.slug }}" {{ '' if loop.first else 'hidden' }}>
        <h3>{{ s.name }}</h3>
        <p class="lede">{{ s.summary }}</p>
        <ul class="bullets two-col">{% for b in content.trust %}<li>{{ b.title }}</li>{% endfor %}</ul>
        <a class="btn btn-accent" href="{% if t.city and not single_service %}/services/{{ s.slug }}/{{ t.slug }}{% else %}/services/{{ s.slug }}{% endif %}">More on {{ s.name|lower }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
