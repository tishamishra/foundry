{# Per-service icon: picks a clean line icon by keyword in the service name, with
   a sensible default. Blue main stroke (.io-b) + one orange accent (.io-a).
   Trade-agnostic keywords cover the common home-service verticals. #}
{%- macro icon(name) -%}
{%- set n = (name or '')|lower -%}
<svg class="svg-ic" viewBox="0 0 24 24" aria-hidden="true">
{%- if 'leak' in n or 'detect' in n -%}
<path class="io-b" d="M12 3.2c0 0 6.6 6.7 6.6 11.1a6.6 6.6 0 1 1-13.2 0C5.4 9.9 12 3.2 12 3.2Z"/><path class="io-a" d="M9.4 14.6a2.7 2.7 0 0 0 2.7 2.6"/>
{%- elif 'drain' in n or 'sewer' in n or 'clog' in n -%}
<circle class="io-b" cx="12" cy="14" r="7.4"/><path class="io-b" d="M8.6 12h6.8M8.6 14.5h6.8M8.6 17h6.8"/><path class="io-a" d="M12 2.2v4.4m-2-1.7 2 1.9 2-1.9"/>
{%- elif 'heater' in n or 'water heat' in n or 'boiler' in n or 'tank' in n -%}
<rect class="io-b" x="6" y="4" width="12" height="17" rx="3.2"/><path class="io-b" d="M9.2 4V2.4m5.6 1.6V2.4"/><circle class="io-a" cx="12" cy="14.5" r="2.7"/>
{%- elif 'emergency' in n or '24' in n or 'urgent' in n -%}
<path class="io-b" d="M12 2.6 5.2 5v6c0 4.5 2.9 7.7 6.8 9 3.9-1.3 6.8-4.5 6.8-9V5L12 2.6Z"/><path class="io-a" d="M12.7 8.2 10 12h2.4l-1 3.4"/>
{%- elif 'repip' in n or 'pipe' in n or 'plumb' in n -%}
<path class="io-b" d="M4 8h5.5a2.4 2.4 0 0 1 2.4 2.4v3.2a2.4 2.4 0 0 0 2.4 2.4H20"/><circle class="io-a" cx="4" cy="8" r="1.7"/><circle class="io-a" cx="20" cy="16" r="1.7"/>
{%- elif 'fixture' in n or 'install' in n or 'faucet' in n or 'tap' in n or 'toilet' in n -%}
<path class="io-b" d="M3.5 10h6.5V8.4a4 4 0 0 1 8 0v1"/><path class="io-b" d="M6.8 10v2.6a3.2 3.2 0 0 0 3.2 3.2h1.3"/><path class="io-a" d="M11.3 17.8v1.5m0 1.9v.02"/>
{%- elif 'roof' in n or 'shingle' in n or 'replace' in n -%}
<path class="io-b" d="M3 11.5 12 4l9 7.5"/><path class="io-b" d="M5 10.5V20h14v-9.5"/><path class="io-a" d="M10 20v-5h4v5"/>
{%- elif 'gutter' in n or 'downspout' in n -%}
<path class="io-b" d="M3 7h18l-1.5 4H4.5L3 7Z"/><path class="io-b" d="M6 11v3a2 2 0 0 0 2 2h1"/><path class="io-a" d="M15 15v3m0 2v.02"/>
{%- elif 'inspect' in n or 'assess' in n or 'survey' in n -%}
<circle class="io-b" cx="11" cy="11" r="6.2"/><path class="io-b" d="m20 20-4.2-4.2"/><path class="io-a" d="M8.6 11a2.4 2.4 0 0 1 2.4-2.4"/>
{%- elif 'clean' in n or 'wash' in n or 'maint' in n -%}
<path class="io-b" d="M7 3v6M5 9h4M7 9c-1.6 3-2 5-2 7a2 2 0 0 0 4 0c0-2-.4-4-2-7Z"/><path class="io-a" d="M15 5l4 4-6 6-4-4 6-6Z"/>
{%- else -%}
<path class="io-b" d="M14.5 4.5a4 4 0 0 0-5 5L4 15v5h5l5.5-5.5a4 4 0 0 0 5-5l-3 3-2-2 3-3a4 4 0 0 0-3-.5Z"/><circle class="io-a" cx="7" cy="17" r="1"/>
{%- endif -%}
</svg>
{%- endmacro -%}
