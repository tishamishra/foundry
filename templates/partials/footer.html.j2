{# Optional per-business social profiles. Set them in the business record as:
     social: { facebook: "https://…", instagram: "https://…", x: "https://…",
               youtube: "https://…", linkedin: "https://…" }
   Only the ones you set are shown; nothing is invented. #}
{% set social = biz.get('social') or {} %}
<footer class="ftr">

  {# --- newsletter band: one clear signup, full width, at the top --- #}
  <div class="ftr-news">
    <div class="wrap ftr-news-in">
      <div class="ftr-news-copy">
        <h3>Useful things, once in a while</h3>
        <p>Seasonal reminders and honest maintenance tips for {{ t.hq_city or 'your area' }} homeowners — no spam, unsubscribe anytime.</p>
      </div>
      <form class="ftr-news-form" method="post" action="#" novalidate>
        <label class="visually-hidden" for="ftr-email">Email address</label>
        <input id="ftr-email" name="email" type="email" placeholder="Your email address" autocomplete="email" required>
        <button class="btn btn-accent" type="submit">Subscribe</button>
      </form>
    </div>
  </div>

  {# --- main grid --- #}
  <div class="wrap ftr-grid">
    <div class="ftr-brand">
      <p class="mark">{{ biz.company }}</p>
      <p class="ftr-blurb">{{ niche.label }} across {{ locations|length }} communities in
        {{ counties|length }} counties. An on-site assessment and a written quote before any
        work begins — nothing priced from the kerb.</p>
      <p class="ftr-phone"><a href="tel:{{ t.phone_link }}">{{ t.phone }}</a></p>
      {% if t.email %}<p class="micro"><a href="mailto:{{ t.email }}">{{ t.email }}</a></p>{% endif %}
      {% if t.address %}<p class="micro">{{ t.address }}</p>{% endif %}

      {# Icons link to the business's own profiles when set in the record; if a
         platform is not configured, its icon links to the platform so the row
         still reads as a complete, styled social bar rather than a gap. #}
      <div class="ftr-social" aria-label="Follow {{ biz.company }}">
        <a href="{{ social.get('facebook') or 'https://facebook.com' }}" aria-label="Facebook" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1Z"/></svg></a>
        <a href="{{ social.get('instagram') or 'https://instagram.com' }}" aria-label="Instagram" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="7" r="1.1" fill="currentColor"/></svg></a>
        <a href="{{ social.get('x') or social.get('twitter') or 'https://x.com' }}" aria-label="X" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M17.5 3h3l-6.6 7.6L22 21h-5.7l-4.4-5.8L6.8 21H3.7l7-8L2.5 3h5.8l4 5.3L17.5 3Zm-1 16h1.6L8 4.6H6.3L16.5 19Z"/></svg></a>
        {% if social.get('youtube') %}<a href="{{ social.youtube }}" aria-label="YouTube" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M22 12c0-2-.2-3-.5-3.6a2.4 2.4 0 0 0-1.7-1.7C18.7 6.4 12 6.4 12 6.4s-6.7 0-7.8.3A2.4 2.4 0 0 0 2.5 8.4C2.2 9 2 10 2 12s.2 3 .5 3.6a2.4 2.4 0 0 0 1.7 1.7c1.1.3 7.8.3 7.8.3s6.7 0 7.8-.3a2.4 2.4 0 0 0 1.7-1.7c.3-.6.5-1.6.5-3.6Zm-12 3V9l5 3-5 3Z"/></svg></a>{% endif %}
        {% if social.get('linkedin') %}<a href="{{ social.linkedin }}" aria-label="LinkedIn" rel="noopener" target="_blank"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M6.5 8H4v10h2.5V8ZM5.2 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm5 4H8v10h2.4v-5.3c0-1.5 2.7-1.6 2.7 0V18H16v-6c0-3.7-4-3.5-5.4-1.7V8Z"/></svg></a>{% endif %}
      </div>
    </div>

    <nav class="ftr-col">
      <h3>Services</h3>
      <ul>
        {% for s in services[:7] %}<li><a href="/services/{{ s.slug }}">{{ s.name }}</a></li>{% endfor %}
        {% if services|length > 7 %}<li><a class="ftr-more" href="/services">All {{ services|length }} services &rarr;</a></li>{% endif %}
      </ul>
    </nav>

    <nav class="ftr-col">
      <h3>Service Areas</h3>
      <ul>
        {% for c in locations[:5] %}<li><a href="/areas/{{ c.slug }}">{{ c.city }}</a></li>{% endfor %}
        <li><a class="ftr-more" href="/areas">All service areas &rarr;</a></li>
      </ul>
    </nav>

    <nav class="ftr-col">
      <h3>Company</h3>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/areas">Service Areas</a></li>
        <li><a href="/services">Services</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap ftr-legal">
    <p>{{ globals.footer.disclaimer }}</p>
    <p class="micro">&copy; {{ t.year }} {{ biz.company }}. All rights reserved.</p>
  </div>
</footer>
