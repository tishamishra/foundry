{% from "partials/_svc_icons.html.j2" import icon %}
<section class="sec showcase">
  <div class="wrap">
    <h2 class="section-head">{{ content.headings.services or ('What we do in ' ~ t.city if t.city else 'What we do') }}</h2>
    <div class="svc-grid">
      {% for s in services %}
      <a class="svc-card" href="{% if t.city and not single_service %}/services/{{ s.slug }}/{{ t.slug }}{% else %}/services/{{ s.slug }}{% endif %}">
        <span class="ic">{{ icon(s.name) }}</span>
        <h3>{{ s.name }}{% if t.city %} in {{ t.city }}{% endif %}</h3>
        <p>{{ s.summary }}</p>
        <span class="more">Read about {{ s.name|lower }} &rarr;</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
