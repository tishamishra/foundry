{# Business intro after the hero: the story + a trust checklist on the left,
   a photo and a "ready to get started" call card on the right. Trust points,
   about copy and image are all drawn by the composer, so this varies per site.
   The checklist REPLACES the plain trust band on the home page. #}
{% set pic = imgs.about or imgs.hero %}
<section class="sec intro-split">
  <div class="wrap isplit">
    <div class="isplit-copy">
      <p class="eyebrow">About {{ biz.company }}</p>
      <h2>{{ content.headings.get('about') or ('Trusted ' ~ t.niche_lower ~ ', done properly') }}</h2>
      <div class="prose">
        {% for para in content.about.paras %}<p>{{ para }}</p>{% endfor %}
      </div>
      {% if content.trust %}
      <ul class="tick-list">
        {% for point in content.trust %}
        <li class="tick">
          <span class="tick-b" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15"><path d="M5 12.5l4.2 4.3L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <div class="tick-t">
            <b>{{ point.title }}</b>
            {% if point.get('text') %}<span>{{ point.text }}</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>

    <div class="isplit-side">
      {% if pic %}
      <div class="isplit-pic"><img src="{{ pic }}" alt="{{ biz.company }}" loading="lazy" width="720" height="560"></div>
      {% endif %}
      <div class="isplit-cta">
        <div class="isplit-rate">
          <span class="isplit-stars" aria-hidden="true">★★★★★</span>
          <span>Rated by local homeowners</span>
        </div>
        <h3>Ready to get started?</h3>
        <p class="isplit-note">Tell us what's happening and we'll talk you through the options — a straight answer and a written quote before any work begins.</p>
        <a class="isplit-phone" href="tel:{{ t.phone_link }}">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" fill="currentColor"/></svg>
          {{ t.phone }}
        </a>
        <a class="btn btn-light" href="tel:{{ t.phone_link }}">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" style="vertical-align:-2px;margin-right:.4rem"><path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" fill="currentColor"/></svg>Call now
        </a>
      </div>
    </div>
  </div>
</section>
