<section class="sec why-sec">
  <div class="wrap">
    <h2 class="section-head">{{ content.headings.why or ('Why homeowners call ' ~ biz.company) }}</h2>
    <div class="why-grid">
      {% for item in content.why_us %}
      <div class="why-card">
        <span class="why-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12.5l4.2 4.3L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
