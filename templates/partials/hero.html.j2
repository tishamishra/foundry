{# One markup, four shapes. The variant lives on <body data-hero> and the
   stylesheet carries a rule for each value, so a new hero is a CSS block and a
   line of YAML — never a new template. #}
<section class="hero">
  {% if style.hero in ('overlay', 'banner') %}
  <div class="hero-bg" aria-hidden="true"><img src="{{ imgs.hero or '/assets/hero.svg' }}" alt="" width="1600" height="900" fetchpriority="high"></div>
  {% endif %}
  <div class="wrap hero-in">
    <div class="hero-copy">
      <p class="eyebrow">
        {%- if t.city %}{{ t.city }}, {{ t.state_abbr }}{% if t.county %} &middot; {{ t.county }}{% endif %}
        {%- else %}{{ niche.label }} contractor{% endif -%}
      </p>
      <h1 class="hero-h1">
        {%- if kind == 'location_service' %}{{ t.service }} in <em>{{ t.city }}</em>, {{ t.state_abbr }}
        {%- elif kind == 'location' %}{{ niche.label }} in <em>{{ t.city }}</em>, {{ t.state_abbr }}
        {%- elif kind == 'service' %}{{ t.service }}
        {%- else %}{{ content.tagline }}{% endif -%}
      </h1>
      {%- if show_zips and kind in ('location', 'location_service') and t.primary_zip %}
      <p class="hero-zip">{{ t.city }}, {{ t.state_abbr }} &middot; {{ t.primary_zip }}</p>
      {%- endif %}
      <p class="lede">
        {%- if kind in ('location', 'location_service') and lc is defined and lc.hero %}{{ lc.hero }}
        {%- elif kind == 'service' and svc is defined and svc.hero %}{{ svc.hero }}
        {%- else %}{{ content.hero_intro }}{% endif -%}
      </p>
      <ul class="ticks">
        {% for point in content.trust %}<li>{{ point.title }}</li>{% endfor %}
      </ul>
      <div class="cta-row">
        <a class="btn btn-accent btn-lg" href="tel:{{ t.phone_link }}">{{ content.hero_cta }}</a>
        <a class="btn btn-ghost btn-lg" href="#quote">Request a callback</a>
      </div>
      <p class="micro">Call {{ t.phone }}{% if t.hours %} &middot; {{ t.hours }}{% endif %}</p>
    </div>
    {% if style.hero in ('split', 'stacked') %}
    {% set mapq = (t.city ~ ', ' ~ t.state_abbr) if t.city else ((t.county ~ ', ' ~ t.state_abbr) if t.county else (t.hq_city ~ ', ' ~ t.hq_state)) %}
    <div class="hero-art">
      {% if kind in ('location', 'location_service', 'service', 'county') and mapq|trim(', ') %}
      {# Local pages show the service-area map. Static HTML, no CSP to configure. #}
      <div class="mapembed"><iframe title="Service area map — {{ mapq }}" loading="lazy"
        src="https://maps.google.com/maps?q={{ mapq|urlencode }}&t=&z=11&ie=UTF8&iwloc=&output=embed"></iframe></div>
      <p class="maptag">Serving {{ mapq }}</p>
      {% elif imgs.hero %}
      <img src="{{ imgs.hero }}" alt="{{ niche.label }} work by {{ biz.company }}" width="800" height="500" fetchpriority="high">
      <div class="hero-chip"><strong>{{ locations|length }}</strong><span>communities covered</span></div>
      {% else %}
      {# No photo uploaded yet — a theme-coloured illustration fills the space
         instead of a phone-number pitch, so the hero stays image-led. A real
         photo (added in the Images section) is preferred over this whenever the
         site has one. #}
      <aside class="hero-visual" aria-hidden="true">
        <svg class="hv-scene" viewBox="0 0 440 330" role="img" xmlns="http://www.w3.org/2000/svg">
          <!-- sky panel -->
          <rect x="0" y="0" width="440" height="330" rx="20" fill="var(--brand-light)"/>
          <!-- sun / soft warm glow (kept in the brand family so the single
               accent moment is the guarantee badge below) -->
          <circle cx="360" cy="78" r="34" fill="var(--brand)" opacity=".16"/>
          <!-- distant house -->
          <g opacity=".5">
            <path d="M60 176 L110 138 L160 176 Z" fill="var(--brand-dark)"/>
            <rect x="74" y="176" width="72" height="60" fill="var(--brand)"/>
          </g>
          <!-- main house -->
          <rect x="150" y="150" width="180" height="128" rx="8" fill="#fff" stroke="var(--line)"/>
          <path d="M138 156 L240 78 L342 156 Z" fill="var(--brand)"/>
          <path d="M240 78 L342 156 L318 156 L240 96 Z" fill="var(--brand-dark)" opacity=".85"/>
          <rect x="300" y="96" width="18" height="34" fill="var(--brand-dark)"/>
          <!-- door -->
          <rect x="222" y="214" width="44" height="64" rx="5" fill="var(--brand)"/>
          <circle cx="258" cy="248" r="3" fill="#fff"/>
          <!-- windows -->
          <rect x="170" y="178" width="40" height="38" rx="5" fill="var(--brand-light)" stroke="var(--line)"/>
          <rect x="286" y="178" width="40" height="38" rx="5" fill="var(--brand-light)" stroke="var(--line)"/>
          <!-- ground -->
          <rect x="20" y="278" width="400" height="12" rx="6" fill="var(--brand)" opacity=".18"/>
          <!-- shrubs -->
          <circle cx="128" cy="272" r="16" fill="var(--brand)" opacity=".55"/>
          <circle cx="352" cy="272" r="20" fill="var(--brand)" opacity=".45"/>
          <!-- guarantee badge with check — the one accent moment -->
          <circle cx="360" cy="210" r="40" fill="#fff"/>
          <circle cx="360" cy="210" r="34" fill="var(--accent)"/>
          <path d="M343 210 l11 11 20 -22" fill="none" stroke="var(--accent-text)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="hv-foot">
          <span class="hv-stars" aria-hidden="true">★★★★★</span>
          <span class="hv-cap">Trusted by local homeowners</span>
        </div>
      </aside>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>
