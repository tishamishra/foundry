{#- The DIRECTORY template. One file, three page modes (home / city / provider),
    chosen by the `page` variable. Self-contained header and footer (the normal
    site partials expect a single-business context this page does not have) and
    it reuses site.css + the theme :root, so a directory matches the themes. -#}
{%- set page_url = 'https://' ~ domain ~ ('' if url == '/' else url) -%}
{%- set social = site.get('social') or {} -%}
{# --- FAQ data (single source for the visible accordion AND FAQPage schema) --- #}
{%- set faqs = [] -%}
{%- if page == 'city' -%}
  {%- set _f = [] -%}
  {%- set _ = _f.append({'q': 'How many ' ~ niche_label|lower ~ ' companies are listed in ' ~ city.city ~ '?', 'a': (city.count|string) ~ ' in ' ~ city.place ~ ' right now, and more are added as new local businesses join the directory.'}) -%}
  {%- set _ = _f.append({'q': 'Are these ' ~ city.city ~ ' ' ~ niche_label|lower ~ ' companies vetted?', 'a': 'Listings are drawn from local ' ~ niche_label|lower ~ ' businesses serving ' ~ city.place ~ '. Always confirm licensing, insurance and recent reviews directly with a business before hiring.'}) -%}
  {%- set _ = _f.append({'q': 'How do I contact a ' ~ niche_label|lower ~ ' company in ' ~ city.city ~ '?', 'a': 'Open any listing to see the phone number and, where available, email, website and a map, then reach out to the business directly.'}) -%}
  {%- set _ = _f.append({'q': 'Is it free to use this directory?', 'a': 'Yes. Browsing and contacting ' ~ niche_label|lower ~ ' companies in ' ~ city.city ~ ' is completely free — you deal with each business directly, with no lead fees.'}) -%}
  {%- set _ = _f.append({'q': 'How do I compare ' ~ niche_label|lower ~ ' companies in ' ~ city.city ~ '?', 'a': 'Look at the services each one offers, their ratings and how close they are to you, then shortlist two or three and contact them directly to talk through your job.'}) -%}
  {%- set _ = _f.append({'q': 'Can I get quotes from more than one ' ~ niche_label|lower ~ ' company?', 'a': 'Yes, and it is worth doing. Reach out to a few ' ~ niche_label|lower ~ ' companies in ' ~ city.city ~ ' and ask each for a written quote so you can compare price and scope before deciding.'}) -%}
  {%- set _ = _f.append({'q': 'What should I ask before hiring a ' ~ niche_label|lower ~ ' company?', 'a': 'Confirm they are licensed and insured, ask about experience with your type of job, get the price in writing, and check recent reviews before any work begins.'}) -%}
  {%- set _ = _f.append({'q': 'Do these companies also serve areas near ' ~ city.city ~ '?', 'a': 'Many ' ~ niche_label|lower ~ ' companies listed in ' ~ city.city ~ ' also cover nearby towns and neighbourhoods. Confirm your exact address is in their service area when you get in touch.'}) -%}
  {%- set _ = _f.append({'q': 'How often is the ' ~ city.city ~ ' listing updated?', 'a': 'New local ' ~ niche_label|lower ~ ' businesses appear here as they are added to the directory, so the ' ~ city.city ~ ' list grows over time.'}) -%}
  {%- set _ = _f.append({'q': 'What information does each listing show?', 'a': 'Each listing shows the company name and phone number, plus email, website, address, a map and the services it covers where those details are available.'}) -%}
  {%- set faqs = _f -%}
{%- elif page == 'provider' -%}
  {%- set plist = prov.services or services -%}
  {%- set _f = [] -%}
  {%- set _ = _f.append({'q': 'How do I contact ' ~ prov.name ~ '?', 'a': ('Call ' ~ prov.phone ~ '. ' if prov.phone else '') ~ ('Email ' ~ prov.email ~ '. ' if prov.email else '') ~ ('You can also find them at ' ~ prov.address_full ~ '.' if prov.address_full else 'Use the contact details on this page.')}) -%}
  {%- set _ = _f.append({'q': 'Where is ' ~ prov.name ~ ' located?', 'a': (prov.name ~ ' is located at ' ~ prov.address_full ~ '.' if prov.address_full else prov.name ~ ' is based in ' ~ (prov.place or 'the local area') ~ '.') ~ ' Use the map on this page to see the exact area they work from.'}) -%}
  {%- set _ = _f.append({'q': 'What areas does ' ~ prov.name ~ ' serve?', 'a': prov.name ~ ' is based in ' ~ (prov.place or 'the local area') ~ ' and serves ' ~ (prov.city or prov.place or 'the surrounding area') ~ ' and nearby communities. Confirm your address is covered when you get in touch.'}) -%}
  {%- set _ = _f.append({'q': 'What ' ~ niche_label|lower ~ ' services does ' ~ prov.name ~ ' offer?', 'a': ('Typical services include ' ~ (plist[:6]|join(', ')) ~ '. ' if plist else '') ~ 'Contact ' ~ prov.name ~ ' to confirm they cover your specific job.'}) -%}
  {%- set _ = _f.append({'q': 'Is ' ~ prov.name ~ ' licensed and insured?', 'a': 'Reputable ' ~ niche_label|lower ~ ' companies carry the right licensing and insurance for the work they do. Always ask ' ~ prov.name ~ ' to confirm their current credentials before hiring.'}) -%}
  {%- if prov.hours -%}{%- set _ = _f.append({'q': 'What are ' ~ prov.name ~ "'s hours?", 'a': prov.name ~ ' lists these hours: ' ~ prov.hours ~ '. Call ahead to confirm availability, especially for urgent or after-hours work.'}) -%}{%- endif -%}
  {%- set _ = _f.append({'q': 'How much does ' ~ prov.name ~ ' charge?', 'a': 'Prices depend on the job. Contact ' ~ prov.name ~ ' directly to describe your project and ask for a written quote — there is no cost to request one through this directory.'}) -%}
  {%- set _ = _f.append({'q': 'How do I get a quote from ' ~ prov.name ~ '?', 'a': ('Call ' ~ prov.phone ~ ' or use ' if prov.phone else 'Use ') ~ 'the contact details on this page, describe your job and ask for a written estimate before any work starts.'}) -%}
  {%- set _ = _f.append({'q': 'How do I choose between ' ~ niche_label|lower ~ ' companies?', 'a': 'Compare the services each one offers, their ratings and how close they are, then ask a couple for a written quote before deciding. The related companies on this page make it easy to line up options.'}) -%}
  {%- set _ = _f.append({'q': 'Are there other ' ~ niche_label|lower ~ ' companies near ' ~ (prov.city or prov.place or 'here') ~ '?', 'a': 'Yes. Scroll to the related companies on this page to see other ' ~ niche_label|lower ~ ' businesses nearby, so you can compare a few before you hire.'}) -%}
  {%- set faqs = _f -%}
{%- elif page == 'home' -%}
  {%- set _f = [] -%}
  {%- set _ = _f.append({'q': 'How do I choose a ' ~ niche_label|lower ~ ' company?', 'a': 'Compare ratings, the services each one offers and how close they are, then contact a few directly to talk through your job and get a written quote before any work begins.'}) -%}
  {%- set _ = _f.append({'q': 'Is it free to use this directory?', 'a': 'Yes. Browsing the listings and contacting any business is completely free — you deal with each company directly, with no lead fees or middleman.'}) -%}
  {%- set _ = _f.append({'q': 'Are these ' ~ niche_label|lower ~ ' companies vetted?', 'a': 'Listings are drawn from local ' ~ niche_label|lower ~ ' businesses serving this area. Always confirm licensing, insurance and recent reviews directly with a business before hiring.'}) -%}
  {%- set _ = _f.append({'q': 'How many ' ~ niche_label|lower ~ ' companies are listed?', 'a': (total|string) ~ ' across ' ~ (cities|length|string) ~ ' ' ~ ('city' if cities|length == 1 else 'cities') ~ ', and the list grows as more local businesses are added.'}) -%}
  {%- set _ = _f.append({'q': 'How do I contact a business in the directory?', 'a': 'Open any listing to see the phone number and, where available, email, website and a map, then reach out to the company directly.'}) -%}
  {%- set _ = _f.append({'q': 'What areas does this directory cover?', 'a': 'It covers ' ~ (cities|length|string) ~ ' ' ~ ('city' if cities|length == 1 else 'cities') ~ ' and the areas around them. Browse by city to see the ' ~ niche_label|lower ~ ' companies serving each one.'}) -%}
  {%- set _ = _f.append({'q': 'How is this different from a lead-generation site?', 'a': 'You contact each ' ~ niche_label|lower ~ ' company directly using the details on its listing. We do not sell your information or charge lead fees — the directory simply helps you find and reach local businesses.'}) -%}
  {%- set _ = _f.append({'q': 'How often are new companies added?', 'a': 'New local ' ~ niche_label|lower ~ ' businesses are added over time, so it is worth checking back as the directory continues to grow.'}) -%}
  {%- set _ = _f.append({'q': 'What should I check before hiring a ' ~ niche_label|lower ~ ' company?', 'a': 'Confirm the company is licensed and insured, ask about experience with your type of job, get the price in writing, and read recent reviews before work begins.'}) -%}
  {%- set faqs = _f -%}
{%- endif -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="canonical" href="{{ page_url }}">
<meta property="og:site_name" content="{{ dir_title }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page_url }}">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="theme-color" content="{{ theme.brand }}">
{% if style.fonts_url %}<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ style.fonts_url }}">{% endif %}
<link rel="stylesheet" href="/assets/css/site.css">
<style>
:root{
--brand:{{ theme.brand }};--brand-dark:{{ theme.brand_dark }};--brand-light:{{ theme.brand_light }};
--accent:{{ theme.accent }};--accent-text:{{ theme.accent_text }};--ink:{{ theme.ink }};
--muted:{{ theme.muted }};--line:{{ theme.line }};--surface:{{ theme.surface }};
--font-display:{{ style.display_font }};--font-body:{{ style.body_font }};
--radius:{{ style.radius }};--star:{{ theme.get('star') or '#f6b100' }};
}
</style>
{# --- Structured data: WebSite + Organization publisher (Bing & Google read
   this to identify and link the site). sameAs lists any configured socials. --- #}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","@id":"https://{{ domain }}/#website","name":{{ dir_title|tojson }},"url":"https://{{ domain }}/","publisher":{"@id":"https://{{ domain }}/#org"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","@id":"https://{{ domain }}/#org","name":{{ dir_title|tojson }},"url":"https://{{ domain }}/"{% if social %},"sameAs":[{% for v in social.values() %}{{ v|tojson }}{{ "," if not loop.last }}{% endfor %}]{% endif %}}
</script>
{# --- BreadcrumbList: gives search engines the page's place in the site. --- #}
{%- set crumbs = [{'n': dir_title, 'u': '/'}] -%}
{%- if page == 'all' -%}{% set _ = crumbs.append({'n':'All businesses','u':'/businesses'}) %}
{%- elif page == 'city' -%}{% set _ = crumbs.append({'n':'All businesses','u':'/businesses'}) %}{% set _ = crumbs.append({'n': city.place, 'u': '/city/' ~ city.slug}) %}
{%- elif page == 'provider' -%}{% if prov.place %}{% set _ = crumbs.append({'n': prov.place, 'u':'/city/' ~ (prov.place|slug)}) %}{% endif %}{% set _ = crumbs.append({'n': prov.name, 'u': url}) %}
{%- endif -%}
{% if crumbs|length > 1 %}<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for c in crumbs %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ c.n|tojson }},"item":"https://{{ domain }}{{ '' if c.u == '/' else c.u }}"}{{ "," if not loop.last }}{% endfor %}]}
</script>{% endif %}
{# --- ItemList of the businesses on list pages (home / all / city). --- #}
{% if page in ('home', 'all', 'city') %}
{% set listed = (city.providers if page == 'city' else providers) %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","numberOfItems":{{ listed|length }},"itemListElement":[{% for prov in listed %}{"@type":"ListItem","position":{{ loop.index }},"url":"https://{{ domain }}/provider/{{ prov.slug }}","item":{"@type":"LocalBusiness","name":{{ prov.name|tojson }}{% if prov.phone %},"telephone":{{ prov.phone|tojson }}{% endif %}{% if prov.place %},"areaServed":{{ prov.place|tojson }}{% endif %}{% if prov.website %},"url":{{ prov.website|tojson }}{% endif %}{% if prov.rating %},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ prov.rating }}","bestRating":"5"}{% endif %}}}{{ "," if not loop.last }}{% endfor %}]}
</script>
{% elif page == 'provider' %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"LocalBusiness","@id":"{{ page_url }}#business","name":{{ prov.name|tojson }},"url":"{{ page_url }}"{% if prov.phone %},"telephone":{{ prov.phone|tojson }}{% endif %}{% if prov.email %},"email":{{ prov.email|tojson }}{% endif %}{% if prov.website %},"sameAs":[{{ prov.website|tojson }}]{% endif %}{% if prov.address_full %},"address":{"@type":"PostalAddress","streetAddress":{{ prov.address_full|tojson }}{% if prov.state_abbr %},"addressRegion":{{ prov.state_abbr|tojson }}{% endif %}{% if prov.city %},"addressLocality":{{ prov.city|tojson }}{% endif %},"addressCountry":"US"}{% endif %}{% if prov.place %},"areaServed":{{ prov.place|tojson }}{% endif %}{% if prov.hours %},"openingHours":{{ prov.hours|tojson }}{% endif %}{% if prov.rating %},"aggregateRating":{"@type":"AggregateRating","ratingValue":"{{ prov.rating }}","bestRating":"5"}{% endif %}}
</script>
{% endif %}
{# --- FAQPage from the visible FAQ (city / provider pages). --- #}
{% if faqs %}<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faqs %}{"@type":"Question","name":{{ f.q|tojson }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a|tojson }}}}{{ "," if not loop.last }}{% endfor %}]}
</script>{% endif %}
<style>
/* ---- directory-specific styling (rides on top of site.css + the theme) ---- */
.dir-hdr{position:sticky;top:0;z-index:60;background:#fff;border-bottom:1px solid var(--line)}
.dir-hdr .wrap{display:flex;align-items:center;gap:1rem;min-height:66px}
.dir-brand{font-family:var(--font-display),serif;font-weight:800;font-size:1.16rem;color:var(--ink);flex:1}
.dir-brand a{color:inherit}
.dir-hdr nav{display:none;gap:1.3rem}
.dir-hdr nav a{color:var(--muted);font-weight:600;font-size:.94rem}
.dir-hdr nav a:hover{color:var(--brand-dark)}
@media(min-width:760px){.dir-hdr nav{display:flex}}
.dir-hero{background:linear-gradient(160deg,var(--brand-light),#fff);border-bottom:1px solid var(--line);
  padding:clamp(2.4rem,6vw,4.2rem) 0}
.dir-hero h1{font-size:clamp(1.9rem,5vw,3rem);line-height:1.1;margin:0 0 .6rem}
.dir-hero p{color:var(--muted);font-size:1.08rem;max-width:56ch;margin:0}
.dir-stat{display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:1.1rem;color:var(--muted);font-size:.9rem;font-weight:600}
.dir-stat b{color:var(--brand-dark);font-family:var(--font-display),serif}
.dir-search{display:flex;gap:.6rem;margin-top:1.5rem;max-width:34rem}
.dir-search input{flex:1;font:inherit;font-size:1rem;padding:.8rem 1rem;border:1px solid var(--line);
  border-radius:calc(var(--radius) + 8px);background:#fff;appearance:none;-webkit-appearance:none}
.dir-search input:focus-visible{outline:2px solid var(--brand);outline-offset:1px;border-color:var(--brand)}
.dir-sec{padding:clamp(2rem,5vw,3.4rem) 0}
.dir-sec h2{font-size:clamp(1.35rem,3vw,1.9rem);margin:0 0 1.3rem}
.city-grid{display:grid;gap:.8rem;grid-template-columns:repeat(2,1fr)}
@media(min-width:640px){.city-grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:1000px){.city-grid{grid-template-columns:repeat(4,1fr)}}
.city-chip{display:flex;justify-content:space-between;align-items:center;gap:.6rem;background:#fff;
  border:1px solid var(--line);border-radius:12px;padding:.85rem 1rem;color:var(--ink);font-weight:650}
.city-chip:hover{border-color:var(--brand);color:var(--brand-dark);text-decoration:none;transform:translateY(-2px);transition:.15s}
.city-chip .n{background:var(--brand-light);color:var(--brand-dark);font-size:.78rem;font-weight:800;
  border-radius:99px;padding:.1rem .55rem}
.prov-grid{display:grid;gap:1.2rem;grid-template-columns:1fr}
@media(min-width:640px){.prov-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1040px){.prov-grid{grid-template-columns:repeat(3,1fr)}}
.prov-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);
  border-radius:16px;padding:1.4rem;box-shadow:0 16px 38px -30px rgba(8,20,55,.4);
  transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
.prov-card:hover{transform:translateY(-3px);box-shadow:0 26px 48px -28px rgba(8,20,55,.5);border-color:color-mix(in srgb,var(--brand) 30%,var(--line))}
.prov-card h3{font-size:1.14rem;margin:0 0 .2rem}
.prov-card h3 a{color:var(--ink)}.prov-card h3 a:hover{color:var(--brand-dark);text-decoration:none}
.prov-place{color:var(--muted);font-size:.88rem;font-weight:600;margin:0 0 .7rem;display:flex;align-items:center;gap:.35rem}
.prov-rate{display:inline-flex;align-items:center;gap:.35rem;font-size:.86rem;font-weight:700;color:var(--ink);margin-bottom:.7rem}
.prov-rate .stars{color:var(--star);letter-spacing:1px}
.prov-rate .c{color:var(--muted);font-weight:600}
.prov-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 1rem}
.prov-tag{background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:.18rem .6rem;font-size:.76rem;color:var(--muted);font-weight:600}
.prov-foot{margin-top:auto;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center}
.prov-foot .btn{padding:.55rem 1rem;font-size:.9rem}
.prov-phone{font-weight:800;color:var(--brand-dark);font-size:.95rem;white-space:nowrap}
.dir-empty{color:var(--muted);background:var(--surface);border:1px dashed var(--line);border-radius:14px;padding:2rem;text-align:center}
.crumbs{font-size:.86rem;color:var(--muted);margin:0 0 1rem;display:flex;gap:.4rem;flex-wrap:wrap}
.crumbs a{color:var(--brand-dark);font-weight:600}
.pv-head{background:linear-gradient(160deg,var(--brand-light),#fff);border-bottom:1px solid var(--line);padding:clamp(2rem,5vw,3rem) 0}
.pv-head h1{font-size:clamp(1.7rem,4.4vw,2.6rem);margin:.2rem 0 .4rem}
.pv-grid{display:grid;gap:2rem;padding:clamp(2rem,5vw,3rem) 0}
@media(min-width:880px){.pv-grid{grid-template-columns:1.3fr .7fr;gap:3rem;align-items:start}}
.pv-detail dl{display:grid;grid-template-columns:auto 1fr;gap:.7rem 1.2rem;margin:0 0 1.5rem}
.pv-detail dt{color:var(--muted);font-weight:700;font-size:.86rem;text-transform:uppercase;letter-spacing:.05em}
.pv-detail dd{margin:0;font-weight:600;min-width:0}
.pv-detail dd a{color:var(--brand-dark)}
.pv-side{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.5rem;box-shadow:0 18px 44px -34px rgba(8,20,55,.42)}
.pv-side .btn{width:100%;margin-bottom:.6rem;text-align:center}
.pv-map{border-radius:12px;overflow:hidden;border:1px solid var(--line);margin-top:1rem;line-height:0}
.pv-map iframe{width:100%;height:230px;border:0;display:block}
.dir-ftr{background:#0e1520;color:rgba(255,255,255,.72);margin-top:2rem}
.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
/* newsletter band */
.dftr-news{background:rgba(255,255,255,.04);border-bottom:1px solid rgba(255,255,255,.1)}
.dftr-news-in{display:grid;gap:1.3rem 3rem;align-items:center;padding:2.1rem 0}
@media(min-width:820px){.dftr-news-in{grid-template-columns:1.1fr .9fr}}
.dftr-news-copy h3{color:#fff;font-size:1.18rem;margin:0 0 .3rem;font-family:var(--font-display),serif}
.dftr-news-copy p{color:rgba(255,255,255,.68);font-size:.9rem;line-height:1.6;margin:0;max-width:46ch}
.dftr-news-form{display:flex;gap:.6rem;flex-wrap:wrap}
.dftr-news-form input{flex:1 1 12rem;min-width:0;font:inherit;font-size:.94rem;padding:.7rem .9rem;
  border-radius:calc(var(--radius) + 8px);border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.06);color:#fff}
.dftr-news-form input::placeholder{color:rgba(255,255,255,.5)}
.dftr-news-form input:focus-visible{outline:2px solid var(--accent);outline-offset:1px;background:rgba(255,255,255,.1)}
/* main columns */
.dftr-grid{display:grid;gap:2rem;grid-template-columns:1fr;padding:2.8rem 0 1.6rem}
@media(min-width:760px){.dftr-grid{grid-template-columns:1.6fr 1fr 1fr 1fr;gap:2.4rem}}
.dftr-brand b{color:#fff;font-family:var(--font-display),serif;font-size:1.24rem;display:block;margin-bottom:.5rem}
.dftr-brand p{color:rgba(255,255,255,.7);font-size:.9rem;line-height:1.7;margin:0 0 1rem;max-width:38ch}
.dftr-social{display:flex;gap:.6rem}
.dftr-social a{display:inline-flex;align-items:center;justify-content:center;width:2.3rem;height:2.3rem;border-radius:50%;
  background:rgba(255,255,255,.08);color:rgba(255,255,255,.85);transition:background .15s ease,color .15s ease,transform .15s ease}
.dftr-social a:hover{background:var(--accent);color:var(--accent-text);transform:translateY(-2px)}
.dftr-col h4{color:#fff;font-size:.8rem;text-transform:uppercase;letter-spacing:.09em;margin:0 0 .85rem}
.dftr-col ul{list-style:none;padding:0;margin:0;display:grid;gap:.5rem;font-size:.9rem}
.dftr-col a{color:rgba(255,255,255,.76)}.dftr-col a:hover{color:#fff}
.dftr-more{color:var(--star)!important;font-weight:700}
.dftr-legal{border-top:1px solid rgba(255,255,255,.12);padding:1.3rem 0 1.8rem;display:flex;flex-wrap:wrap;
  gap:.5rem 1.5rem;justify-content:space-between;align-items:center}
.dftr-legal p{margin:0;font-size:.82rem;color:rgba(255,255,255,.6);max-width:70ch}
.dftr-copy{white-space:nowrap}

/* ===== eLocal-style lead-gen home ===== */
.sec-eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.74rem;font-weight:800;color:var(--brand-dark);margin:0 0 .5rem}
.sec-h2{font-size:clamp(1.5rem,3.4vw,2.2rem);line-height:1.15;margin:0 0 1.6rem;max-width:22ch}
/* hero */
.lead-hero{background:radial-gradient(120% 130% at 85% -10%,color-mix(in srgb,var(--brand) 82%,#fff),var(--brand) 38%,var(--brand-dark) 78%,color-mix(in srgb,var(--brand-dark) 72%,#000));color:#fff;overflow:hidden}
.lh-in{display:grid;gap:2.4rem;padding:clamp(2.6rem,6vw,4.6rem) 0;align-items:center}
@media(min-width:940px){.lh-in{grid-template-columns:1.15fr .85fr}}
.lh-eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.76rem;font-weight:800;color:#fff;opacity:.85;margin:0 0 .8rem}
.lh-copy h1{color:#fff;font-size:clamp(2rem,5vw,3.2rem);line-height:1.08;margin:0 0 .7rem}
.lh-sub{color:rgba(255,255,255,.9);font-size:1.08rem;max-width:52ch;margin:0 0 1.5rem}
.lh-search{display:flex;flex-wrap:wrap;gap:.6rem;background:#fff;border-radius:16px;padding:.7rem;box-shadow:0 30px 60px -30px rgba(8,20,55,.5)}
.lh-field{flex:1 1 12rem;display:flex;flex-direction:column;gap:.15rem;min-width:0;text-align:left;padding:.2rem .6rem}
.lh-field span{font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--muted)}
.lh-field select{font:inherit;font-size:1rem;font-weight:600;border:0;background:transparent;color:var(--ink);padding:.15rem 0;outline:none;cursor:pointer;min-width:0}
.lh-go{flex:0 0 auto;align-self:stretch;border-radius:12px}
@media(max-width:560px){.lh-go{width:100%}}
.lh-trust{margin:1.1rem 0 0;font-size:.9rem;color:rgba(255,255,255,.9);font-weight:600;display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}
.lh-stars{color:var(--star);letter-spacing:1px}
/* hero decorative panel */
.lh-panel{display:none}
@media(min-width:940px){.lh-panel{display:block}}
.lh-card{background:#fff;border-radius:18px;padding:1.4rem;box-shadow:0 40px 80px -30px rgba(8,20,55,.6)}
.lh-card-top{display:flex;gap:.4rem;margin-bottom:1rem}
.lh-dot{width:.6rem;height:.6rem;border-radius:50%;background:var(--line)}
.lh-row{display:flex;align-items:center;gap:.7rem;padding:.6rem 0;border-top:1px solid var(--line)}
.lh-av{flex:none;width:2rem;height:2rem;border-radius:50%;background:linear-gradient(150deg,var(--brand),var(--brand-dark));color:#fff;display:grid;place-items:center;font-weight:800;font-size:.85rem}
.lh-bar{height:.6rem;border-radius:99px;background:var(--brand-light);flex:1}
.lh-bar.w70{max-width:70%}.lh-bar.w55{max-width:55%}.lh-bar.w80{max-width:80%}
.lh-rate{font-size:.8rem;font-weight:800;color:var(--brand-dark);white-space:nowrap}
.lh-cta{margin-top:1rem;text-align:center;background:var(--accent);color:var(--accent-text);font-weight:800;padding:.7rem;border-radius:12px;font-size:.92rem}
/* stat band */
.stat-band{background:var(--ink);color:#fff}
.stat-in{display:grid;grid-template-columns:repeat(2,1fr);gap:1.4rem 1rem;padding:2rem 0;text-align:center}
@media(min-width:820px){.stat-in{grid-template-columns:repeat(4,1fr)}}
.stat-cell b{display:block;font-family:var(--font-display),serif;font-size:clamp(1.8rem,4vw,2.6rem);color:#fff;line-height:1}
.stat-cell span{display:block;margin-top:.35rem;font-size:.82rem;color:rgba(255,255,255,.72);text-transform:uppercase;letter-spacing:.06em;font-weight:600}
/* how it works */
.how-grid{display:grid;gap:1.2rem;grid-template-columns:1fr}
@media(min-width:600px){.how-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.how-grid{grid-template-columns:repeat(4,1fr)}}
.how-step{background:#fff;border:1px solid var(--line);border-radius:16px;padding:2.3rem 1.4rem 1.5rem;position:relative;box-shadow:0 16px 40px -32px rgba(8,20,55,.4)}
.how-n{position:absolute;top:-1rem;left:1.4rem;width:2.5rem;height:2.5rem;border-radius:50%;background:linear-gradient(150deg,var(--brand),var(--brand-dark));color:#fff;display:grid;place-items:center;font-family:var(--font-display),serif;font-weight:800;font-size:1.15rem;box-shadow:0 10px 20px -8px color-mix(in srgb,var(--brand) 60%,transparent)}
.how-step h3{font-size:1.1rem;margin:0 0 .4rem}
.how-step p{color:var(--muted);font-size:.94rem;margin:0;line-height:1.6}
/* why-us feature grid */
.feat-grid{display:grid;gap:1.2rem;grid-template-columns:1fr}
@media(min-width:600px){.feat-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.feat-grid{grid-template-columns:repeat(4,1fr)}}
.feat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.6rem 1.4rem;
  transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease}
.feat:hover{transform:translateY(-3px);box-shadow:0 22px 46px -30px rgba(8,20,55,.5);border-color:color-mix(in srgb,var(--brand) 30%,var(--line))}
.feat-ic{display:inline-flex;align-items:center;justify-content:center;width:3rem;height:3rem;border-radius:14px;
  margin-bottom:1rem;color:var(--brand);
  background:linear-gradient(150deg,color-mix(in srgb,var(--brand) 16%,#fff),color-mix(in srgb,var(--brand) 7%,#fff));
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--brand) 20%,transparent),0 8px 18px -10px color-mix(in srgb,var(--brand) 45%,transparent)}
.feat-ic svg{width:24px;height:24px;display:block}
.feat h3{font-size:1.06rem;margin:0 0 .4rem}
.feat p{color:var(--muted);font-size:.93rem;margin:0;line-height:1.6}
/* service quick-chips */
.svc-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 1.4rem}
.svc-chip{background:#fff;border:1px solid var(--line);border-radius:999px;padding:.4rem .9rem;font:inherit;font-size:.86rem;font-weight:600;color:var(--muted);cursor:pointer;transition:.15s}
.svc-chip:hover{border-color:var(--brand);color:var(--brand-dark)}
.svc-chip.on{background:var(--brand);border-color:var(--brand);color:#fff}
/* FAQ */
.dir-faq details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem;margin-bottom:.7rem}
.dir-faq summary{cursor:pointer;font-weight:700;list-style:none;display:flex;justify-content:space-between;gap:1rem}
.dir-faq summary::-webkit-details-marker{display:none}
.dir-faq summary::after{content:"+";color:var(--brand);font-weight:800;font-size:1.2rem}
.dir-faq details[open] summary::after{content:"–"}
.dir-faq p{margin:.7rem 0 0;color:var(--muted);line-height:1.6}
/* closing CTA */
.dir-cta{background:linear-gradient(150deg,var(--brand),var(--brand-dark));color:#fff}
.dir-cta-in{display:flex;flex-wrap:wrap;gap:1.2rem;align-items:center;justify-content:space-between;padding:2.6rem 0}
.dir-cta h2{color:#fff;margin:0 0 .3rem;font-size:clamp(1.4rem,3vw,2rem)}
.dir-cta p{color:rgba(255,255,255,.9);margin:0}
/* long-form prose (city / all / provider) */
.dir-prose{max-width:70ch}
.dir-prose p{color:var(--muted);font-size:1.02rem;line-height:1.75;margin:0 0 1rem}
.dir-prose .sec-h2{max-width:none}
.pin-ic{vertical-align:-2px}
/* provider services list */
.svc-list{display:grid;gap:.7rem;grid-template-columns:1fr}
@media(min-width:560px){.svc-list{grid-template-columns:1fr 1fr}}
.svc-item{display:flex;gap:.7rem;align-items:flex-start}
.svc-tick{flex:none;width:1.5rem;height:1.5rem;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;
  color:var(--brand);background:color-mix(in srgb,var(--brand) 12%,#fff);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--brand) 20%,transparent);margin-top:.1rem}
.svc-item b{display:block;font-size:.96rem}
.svc-item span{display:block;color:var(--muted);font-size:.86rem;line-height:1.5}
/* related businesses list */
.rel-list{display:grid;gap:.9rem;grid-template-columns:1fr}
@media(min-width:560px){.rel-list{grid-template-columns:1fr 1fr}}
@media(min-width:960px){.rel-list{grid-template-columns:repeat(3,1fr)}}
.rel-card{position:relative;display:flex;flex-direction:column;gap:.25rem;background:#fff;border:1px solid var(--line);
  border-radius:14px;padding:1.1rem 1.15rem;color:inherit;transition:transform .14s ease,box-shadow .14s ease,border-color .14s ease}
.rel-card:hover{transform:translateY(-2px);box-shadow:0 18px 40px -30px rgba(8,20,55,.5);border-color:color-mix(in srgb,var(--brand) 30%,var(--line));text-decoration:none}
.rel-card.best{border-color:color-mix(in srgb,var(--accent) 55%,var(--line));box-shadow:0 18px 40px -28px color-mix(in srgb,var(--accent) 55%,transparent)}
.rel-name{font-weight:800;color:var(--ink);font-size:1rem;line-height:1.25}
.rel-place{color:var(--muted);font-size:.84rem;font-weight:600;display:inline-flex;align-items:center;gap:.3rem}
.rel-foot{display:flex;gap:.8rem;align-items:center;margin-top:.35rem}
.rel-rate{color:var(--brand-dark);font-weight:800;font-size:.84rem}
.rel-phone{color:var(--muted);font-weight:700;font-size:.84rem}
.best-badge{position:absolute;top:-.7rem;left:1rem;background:var(--accent);color:var(--accent-text);
  font-size:.72rem;font-weight:800;letter-spacing:.02em;padding:.2rem .6rem;border-radius:999px;
  box-shadow:0 8px 18px -8px color-mix(in srgb,var(--accent) 60%,transparent)}
.rel-card.best{padding-top:1.4rem}
</style>
</head>
<body class="page-directory" data-style="{{ style.key }}" data-cards="{{ style.cards }}"
      data-headline="{{ style.headline }}" data-accent="{{ style.accent }}">

{%- macro rating(prov) -%}
{%- if prov.rating -%}
<span class="prov-rate"><span class="stars" aria-hidden="true">{% for i in range(5) %}{{ '★' if i < (prov.rating|round(0,'floor')|int) else '☆' }}{% endfor %}</span>{{ '%.1f'|format(prov.rating) }}</span>
{%- endif -%}
{%- endmacro -%}

{%- set pin -%}<svg class="pin-ic" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c4-4.3 6-7.4 6-10a6 6 0 1 0-12 0c0 2.6 2 5.7 6 10Z"/><circle cx="12" cy="11" r="2.2"/></svg>{%- endset -%}

{%- macro card(prov) -%}
<article class="prov-card" data-search="{{ (prov.name ~ ' ' ~ prov.place ~ ' ' ~ (prov.services|join(' ')))|lower }}">
  <h3><a href="/provider/{{ prov.slug }}">{{ prov.name }}</a></h3>
  <p class="prov-place">{{ pin }} {{ prov.place or 'Service area' }}</p>
  {{ rating(prov) }}
  {% if prov.services %}<div class="prov-tags">{% for s in prov.services[:3] %}<span class="prov-tag">{{ s }}</span>{% endfor %}</div>{% endif %}
  <div class="prov-foot">
    {% if prov.phone %}<a class="prov-phone" href="tel:{{ prov.phone_link }}">{{ prov.phone }}</a>{% endif %}
    <a class="btn btn-accent" href="/provider/{{ prov.slug }}">View details</a>
  </div>
</article>
{%- endmacro -%}

{%- macro rel_card(prov, badge='') -%}
<a class="rel-card{{ ' best' if badge }}" href="/provider/{{ prov.slug }}">
  {% if badge %}<span class="best-badge">★ {{ badge }}</span>{% endif %}
  <span class="rel-name">{{ prov.name }}</span>
  <span class="rel-place">{{ pin }} {{ prov.place or 'Service area' }}</span>
  <span class="rel-foot">{% if prov.rating %}<span class="rel-rate">★ {{ '%.1f'|format(prov.rating) }}</span>{% endif %}{% if prov.phone %}<span class="rel-phone">{{ prov.phone }}</span>{% endif %}</span>
</a>
{%- endmacro -%}

<header class="dir-hdr">
  <div class="wrap">
    <span class="dir-brand"><a href="/">{{ dir_title }}</a></span>
    <nav>
      <a href="/businesses">All businesses</a>
      {% for c in cities[:5] %}<a href="/city/{{ c.slug }}">{{ c.city }}</a>{% endfor %}
    </nav>
  </div>
</header>

{% if page == 'home' %}
{# ---------- 1. lead-gen hero with a service + location search ---------- #}
<section class="lead-hero">
  <div class="wrap lh-in">
    <div class="lh-copy">
      <p class="lh-eyebrow">{{ niche_label }} directory{% if avg_rating %} · ★ {{ avg_rating }} average rating{% endif %}</p>
      <h1>Find a trusted local {{ niche_label|lower }} company, fast</h1>
      <p class="lh-sub">{{ tagline }}</p>
      <form class="lh-search" onsubmit="return dirSearch(event)">
        {% if services %}
        <label class="lh-field"><span>What do you need?</span>
          <select id="lh-service">
            <option value="">Any {{ niche_label|lower }} service</option>
            {% for s in services %}<option value="{{ s|lower }}">{{ s }}</option>{% endfor %}
          </select>
        </label>
        {% endif %}
        <label class="lh-field"><span>Where?</span>
          <select id="lh-city">
            <option value="">All areas</option>
            {% for c in cities %}<option value="{{ c.place|lower }}">{{ c.place }}</option>{% endfor %}
          </select>
        </label>
        <button class="btn btn-accent lh-go" type="submit">Find {{ niche_label|lower }} companies</button>
      </form>
      <p class="lh-trust"><span class="lh-stars" aria-hidden="true">★★★★★</span> {{ total }} local {{ niche_label|lower }} businesses across {{ cities|length }} {{ 'city' if cities|length == 1 else 'cities' }}</p>
    </div>
    <div class="lh-panel" aria-hidden="true">
      <div class="lh-card">
        <div class="lh-card-top"><span class="lh-dot"></span><span class="lh-dot"></span><span class="lh-dot"></span></div>
        <div class="lh-row"><span class="lh-av">A</span><span class="lh-bar w70"></span><span class="lh-rate">★ 4.9</span></div>
        <div class="lh-row"><span class="lh-av">B</span><span class="lh-bar w55"></span><span class="lh-rate">★ 4.8</span></div>
        <div class="lh-row"><span class="lh-av">C</span><span class="lh-bar w80"></span><span class="lh-rate">★ 4.7</span></div>
        <div class="lh-cta">Compare &amp; call &rarr;</div>
      </div>
    </div>
  </div>
</section>

{# ---------- 2. proven-results band (REAL counts only, nothing invented) ---------- #}
<section class="stat-band"><div class="wrap stat-in">
  <div class="stat-cell"><b>{{ total }}</b><span>{{ niche_label }} businesses listed</span></div>
  <div class="stat-cell"><b>{{ cities|length }}</b><span>Cities covered</span></div>
  {% if services %}<div class="stat-cell"><b>{{ services|length }}</b><span>Services covered</span></div>{% endif %}
  <div class="stat-cell"><b>{% if avg_rating %}{{ avg_rating }}{% else %}★{% endif %}</b><span>{% if avg_rating %}Average rating{% else %}Rated by locals{% endif %}</span></div>
</div></section>

{# ---------- 3. how it works ---------- #}
<section class="dir-sec"><div class="wrap">
  <p class="sec-eyebrow">How it works</p>
  <h2 class="sec-h2">Find the right {{ niche_label|lower }} company in four steps</h2>
  <div class="how-grid">
    <div class="how-step"><span class="how-n">1</span><h3>Search your area</h3><p>Pick your city or a service to see {{ niche_label|lower }} companies near you.</p></div>
    <div class="how-step"><span class="how-n">2</span><h3>Compare</h3><p>Line up ratings, services and contact details side by side.</p></div>
    <div class="how-step"><span class="how-n">3</span><h3>Contact directly</h3><p>Call or message the business that fits — no middleman, no fees.</p></div>
    <div class="how-step"><span class="how-n">4</span><h3>Get it done</h3><p>Agree the work and a written quote before anything starts.</p></div>
  </div>
</div></section>

{# ---------- 4. why use this directory ---------- #}
<section class="dir-sec sec-alt" style="background:var(--surface)"><div class="wrap">
  <p class="sec-eyebrow">Why use {{ dir_title }}</p>
  <h2 class="sec-h2">Everything you need to choose with confidence</h2>
  <div class="feat-grid">
    <div class="feat">
      <span class="feat-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c4.2-4.5 6.4-7.8 6.4-10.6a6.4 6.4 0 1 0-12.8 0C5.6 13.2 7.8 16.5 12 21Z"/><circle cx="12" cy="10.3" r="2.5"/></svg></span>
      <h3>Local businesses only</h3><p>Every listing is a {{ niche_label|lower }} business serving your area — no national call centres.</p>
    </div>
    <div class="feat">
      <span class="feat-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14M5 12h14M5 17h14"/><circle cx="15" cy="7" r="2" fill="currentColor" stroke="none"/><circle cx="9" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="13" cy="17" r="2" fill="currentColor" stroke="none"/></svg></span>
      <h3>Compare in one place</h3><p>Ratings, services and details for every company, side by side.</p>
    </div>
    <div class="feat">
      <span class="feat-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h3l1.6 4-2.1 1.4a10.5 10.5 0 0 0 4.6 4.6l1.4-2.1 4 1.6v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/></svg></span>
      <h3>Contact directly</h3><p>Reach each business yourself — free to use, with no fees or lead charges.</p>
    </div>
    <div class="feat">
      <span class="feat-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14.8 6.2a3.6 3.6 0 0 0-4.6 4.6l-5.6 5.6a1.6 1.6 0 0 0 2.3 2.3l5.6-5.6a3.6 3.6 0 0 0 4.6-4.6l-2.3 2.3-2-.6-.6-2 2.2-2Z"/></svg></span>
      <h3>Every service covered</h3><p>From small repairs to big installs, find a company for the exact job.</p>
    </div>
  </div>
</div></section>

{# ---------- 5. browse by city ---------- #}
{% if cities %}
<section class="dir-sec"><div class="wrap">
  <p class="sec-eyebrow">Service areas</p>
  <h2 class="sec-h2">Browse {{ niche_label|lower }} companies by city</h2>
  <div class="city-grid">
    {% for c in cities %}<a class="city-chip" href="/city/{{ c.slug }}"><span>{{ c.place }}</span><span class="n">{{ c.count }}</span></a>{% endfor %}
  </div>
</div></section>
{% endif %}

{# ---------- 6. the directory listing (search filters this) ---------- #}
<section class="dir-sec sec-alt" style="background:var(--surface)" id="listings"><div class="wrap">
  <p class="sec-eyebrow">The directory</p>
  <h2 class="sec-h2">{{ total }} {{ niche_label|lower }} {{ 'business' if total == 1 else 'businesses' }} listed</h2>
  <div class="dir-search"><input type="search" id="dirq" placeholder="Search by name, city or service…" aria-label="Search businesses"></div>
  {% if services %}
  <div class="svc-chips">{% for s in services[:10] %}<button type="button" class="svc-chip" data-q="{{ s|lower }}">{{ s }}</button>{% endfor %}</div>
  {% endif %}
  {% if providers %}
  {% set featured = providers|selectattr('featured')|list %}
  <div class="prov-grid" id="provlist">
    {% for prov in (featured + (providers|rejectattr('featured')|list)) %}{{ card(prov) }}{% endfor %}
  </div>
  <p class="dir-empty" id="noresult" hidden>No businesses match that search.</p>
  {% else %}
  <p class="dir-empty">No businesses are listed yet. Add businesses in the engine and they will appear here.</p>
  {% endif %}
</div></section>

{# ---------- 7. FAQ ---------- #}
<section class="dir-sec"><div class="wrap dir-faq">
  <p class="sec-eyebrow">Good to know</p>
  <h2 class="sec-h2">{{ niche_label }} directory — questions answered</h2>
  {% for f in faqs %}<details{{ ' open' if loop.first }}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
</div></section>

{# ---------- 8. closing CTA ---------- #}
<section class="dir-cta"><div class="wrap dir-cta-in">
  <div><h2>Ready to find your {{ niche_label|lower }} company?</h2><p>Search {{ total }} local businesses and contact the right one today.</p></div>
  <a class="btn btn-light btn-lg" href="#listings">Browse the directory &rarr;</a>
</div></section>

{% elif page == 'all' %}
<section class="pv-head"><div class="wrap">
  <p class="crumbs"><a href="/">{{ dir_title }}</a> <span>›</span> <span>All businesses</span></p>
  <h1>All {{ niche_label|lower }} businesses</h1>
  <p style="color:var(--muted);margin:0">Every {{ niche_label|lower }} business we list — {{ total }} across {{ cities|length }} {{ 'city' if cities|length == 1 else 'cities' }}.</p>
</div></section>
<section class="dir-sec"><div class="wrap dir-prose">
  <p>This is the complete {{ dir_title }} — {{ total }} local {{ niche_label|lower }} {{ 'business' if total == 1 else 'businesses' }} serving {{ cities|length }} {{ 'city' if cities|length == 1 else 'cities' }} and the areas around them. Every listing is a real local company with its own contact details and the services it covers, so you can compare a shortlist and reach the right one directly — free, with no lead fees and no middleman.</p>
  <p>Use the search to filter by name, city or service, tap a service to narrow the list, or browse by city below. When you have found a {{ niche_label|lower }} company that fits, open its page for full contact details, a map and other {{ niche_label|lower }} companies nearby.</p>
</div></section>
<section class="dir-sec sec-alt" style="background:var(--surface)" id="listings"><div class="wrap">
  <h2 class="sec-h2">Search all {{ total }} businesses</h2>
  <div class="dir-search"><input type="search" id="dirq" placeholder="Search by name, city or service…" aria-label="Search businesses"></div>
  {% if services %}<div class="svc-chips">{% for s in services[:10] %}<button type="button" class="svc-chip" data-q="{{ s|lower }}">{{ s }}</button>{% endfor %}</div>{% endif %}
  {% set featured = providers|selectattr('featured')|list %}
  <div class="prov-grid" id="provlist">{% for prov in (featured + (providers|rejectattr('featured')|list)) %}{{ card(prov) }}{% endfor %}</div>
  <p class="dir-empty" id="noresult" hidden>No businesses match that search.</p>
</div></section>
{% if cities %}
<section class="dir-sec"><div class="wrap">
  <p class="sec-eyebrow">Service areas</p>
  <h2 class="sec-h2">Browse by city</h2>
