    {% set mapq = prov.address_full or prov.place %}
    {% if mapq %}<div class="pv-map"><iframe title="Map — {{ prov.name }}" loading="lazy" src="https://maps.google.com/maps?q={{ mapq|urlencode }}&t=&z=12&ie=UTF8&iwloc=&output=embed"></iframe></div>{% endif %}
  </aside>
</div>

{% if related %}
<section class="dir-sec sec-alt" style="background:var(--surface)"><div class="wrap">
  <p class="sec-eyebrow">Compare more options</p>
