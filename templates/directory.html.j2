    <p class="dftr-copy">&copy; 2026 {{ dir_title }}. All rights reserved.</p>
  </div>
</footer>

{% if page in ('home', 'all') and providers %}
<script>
(function(){
  var q=document.getElementById('dirq'), list=document.getElementById('provlist'),
      none=document.getElementById('noresult');
  if(!list) return;
  var cards=[].slice.call(list.querySelectorAll('.prov-card'));
  function apply(v){
    var toks=(v||'').toLowerCase().split(/[\s,]+/).filter(Boolean), shown=0;
    cards.forEach(function(c){
      var d=c.getAttribute('data-search');
      var hit=toks.every(function(t){ return d.indexOf(t)>-1; });
      c.hidden=!hit; if(hit) shown++;
    });
    if(none) none.hidden=shown>0;
  }
  if(q) q.addEventListener('input', function(){ apply(q.value); });
  // service quick-chips
  [].slice.call(document.querySelectorAll('.svc-chip')).forEach(function(ch){
    ch.addEventListener('click', function(){
      var val=ch.getAttribute('data-q');
      if(q) q.value=val; apply(val);
      document.querySelectorAll('.svc-chip.on').forEach(function(x){x.classList.remove('on');});
      ch.classList.add('on');
    });
  });
  // hero search form -> build a query from service + city, filter, scroll to listings
  window.dirSearch=function(e){
    e.preventDefault();
    var s=document.getElementById('lh-service'), c=document.getElementById('lh-city');
    var terms=[(s&&s.value)||'', (c&&c.value)||''].filter(Boolean);
    var query=terms.join(' ').trim();
    if(q) q.value=query; apply(query);
    var target=document.getElementById('listings');
    if(target) target.scrollIntoView({behavior:'smooth'});
    return false;
  };
})();
</script>
{% endif %}
</body>
</html>
